{
  "name": "runline",
  "version": "0.46.0",
  "description": "Renamed to @shiftlabs/codemode. This package forwards to it until 0.48.0.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
