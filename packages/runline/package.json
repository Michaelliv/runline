      "types": "./utils/cli.d.ts",
      "import": "./utils/cli.js",
      "default": "./utils/cli.js"
    }
  },
  "bin": {
    "runline": "./cli.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cli.js",
    "utils",
    "README.md"
  ],
