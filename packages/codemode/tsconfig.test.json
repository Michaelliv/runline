{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"],
    // Plugins under test import "@shiftlabs/codemode"; resolving it to this source
    // keeps one declaration of every plugin type in the program.
    "paths": { "@shiftlabs/codemode": ["./src/index.ts"] }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
